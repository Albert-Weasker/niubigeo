# Core real-provider path. OPENROUTER_KEY is also accepted.
OPENROUTER_API_KEY=

# Direct provider keys. These keys are routed only to their own providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
DEEPSEEK_API_KEY=

# Optional server config.
PORT=8787
RUNS_DIR=runs

# External advisor link card. Set false, 0 or off to hide it.
NIUBIGEO_VIDEO_ADVISOR_ENABLED=true

# Self-hosted only: permit local/private HTTP model endpoints in the connection UI.
# NIUBIGEO_ALLOW_LOCAL_PROVIDERS=false

# -------------------
# Prometheus Settings
# -------------------
# Optional Prometheus endpoint. Set METRICS_ENABLED=true to enable /metrics.
# METRICS_ENABLED=false

# An optional password for /metrics. If set, clients must send it as a bearer token or they’ll get 401. 
# Leave it blank for a quick local browser check.
# METRICS_TOKEN=

# Keeps project domains, keyword text, and model display names out of the scrape. 
# Set it to true if you want those labels in Grafana.
# It’s a privacy setting. Leaving false hides project domains, 
# keyword text, and model display names from /metrics. 
# The metrics still work using project and monitor IDs and public catalog model IDs.
# METRICS_INCLUDE_NAMES=false

# Reuses the scrape response for 30 seconds. 
# Set it to 0 if you want each request to reflect the latest stored data during testing.
# METRICS_CACHE_SECONDS=30 
