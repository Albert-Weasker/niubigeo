# Core real-provider path. OPENROUTER_KEY is also accepted.
OPENROUTER_API_KEY=

# Direct provider keys. These keys are routed only to their own providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
DEEPSEEK_API_KEY=

# Optional server config.
PORT=8787
RUNS_DIR=runs

# External advisor link card. Set false, 0 or off to hide it.
NIUBIGEO_VIDEO_ADVISOR_ENABLED=true

# Self-hosted only: permit local/private HTTP model endpoints in the connection UI.
# NIUBIGEO_ALLOW_LOCAL_PROVIDERS=false
