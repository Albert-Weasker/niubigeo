# The candidate context contains only product build inputs and runtime branding.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!tsconfig.json
!src/
!src/**
!assets/
!assets/brand/
!assets/brand/niubigeo-emblem.svg
!assets/brand/niubigeo-lockup.svg

# Keep local data and credentials excluded even inside an allowed source tree.
**/node_modules
**/dist
**/runs
**/data
**/validation
**/rawdata
**/test
**/tests
**/*.test.*
**/test-results
**/playwright-report
**/blob-report
**/*.trace.zip
**/*.webm
**/.env
**/.env.*
**/.git
**/.codex
**/.DS_Store
**/website
**/docs
**/screenshots
